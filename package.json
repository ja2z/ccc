{
  "name": "commerce-control-center",
  "version": "1.0.0",
  "description": "Prototype Commerce Control Center web app with Sigma embed",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && tailwindcss -i src/public/tailwind.css -o src/public/styles.css",
    "dev": "concurrently \"npm run build:css\" \"nodemon\"",
    "build:css": "tailwindcss -i src/public/tailwind.css -o src/public/styles.css -w",
    "start": "node dist/server.js",
    "server:stop": "./scripts/stop-server.sh",
    "server:start": "./scripts/start-server.sh",
    "server:restart": "./scripts/restart-server.sh"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
